# Copy this file to .env and adjust values for your machine.
# .env is git-ignored — never commit real secrets.

# --- Application ---
APP_NAME=InternTrack
APP_ENV=local
# Leave APP_URL empty to auto-detect from the incoming request
# (HTTP_HOST + SCRIPT_NAME). Set it only if auto-detection is wrong
# for your setup (e.g. behind a proxy).
APP_URL=
APP_HOST=127.0.0.1
# Apache port for this vhost. Use 80 for the XAMPP default, or any
# free port — never hardcode a port value in PHP/JS/SQL, read it
# from here instead.
APP_PORT=8012

# --- Database (MySQL / MariaDB via XAMPP) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=interntrack
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- Claude API (optional — app must work with this blank) ---
ANTHROPIC_API_KEY=
AI_FEATURE_ENABLED=true

# --- Academic defaults ---
CGPA_SCALE_DEFAULT=4.00
